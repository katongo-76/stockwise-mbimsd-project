APP_DEBUG=0

DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockwise_php
DB_USER=root
DB_PASSWORD=

# Set to 1 when serving over HTTPS
SESSION_SECURE_COOKIE=0

# SMTP (PHPMailer). Leave SMTP_HOST empty to skip real sending in local dev —
# alerts are still logged to the notifications table.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@yourdomain.com

# ML forecasting (ml/forecast_job.py). All optional; these are the defaults.
# FORECAST_MODEL: auto (the trained model file ml/model/demand_model.joblib, made by
# ml/train_model.py; falls back to holt_winters if it is missing), or force
# random_forest, holt_winters or moving_average.
FORECAST_MODEL=auto
FORECAST_HORIZON_DAYS=14
# Days a supplier takes to deliver, and days of demand each order should cover
FORECAST_LEAD_TIME_DAYS=5
FORECAST_COVER_DAYS=14
# Safety-stock z-score: 1.65 = about 95% chance of not running out during the lead time
FORECAST_SERVICE_Z=1.65
FORECAST_MIN_HISTORY_DAYS=90
